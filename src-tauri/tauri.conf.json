{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault",
  "version": "1.2.1",
  "identifier": "com.ferminlasarte.vault-ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vault",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Fermín Lasarte",
    "copyright": "© 2026 Fermín Lasarte",
    "category": "Finance",
    "shortDescription": "Finanzas personales, en tu equipo",
    "longDescription": "Gestor de finanzas personales local-first: transacciones, cuentas, presupuestos, deudas y ahorros. Todos los datos viven únicamente en este equipo, en una base SQLite, sin servidor ni cuenta.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FerminLasarte/vault-ai/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MTYwRjMwNzFBMEM1RkUKUldUK3hhQnhNQThXMW9vSTN3K3RhYldwdUtlejU3SSsrd0VPa0ZjSksrV0thUWw5bFV5U3d1WHoK"
    }
  }
}
